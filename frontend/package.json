{
  "name": "trend2zero-fp-frontend",
  "version": "0.1.0",
  "description": "PureScript frontend for Trend2Zero-FP",
  "private": true,
  "scripts": {
    "build": "spago build",
    "bundle": "spago bundle-app --to public/app.js",
    "bundle:watch": "spago bundle-app --to public/app.js --watch",
    "webpack": "webpack --mode production",
    "webpack:watch": "webpack --mode development --watch",
    "dev": "webpack serve --mode development --open",
    "test": "spago test",
    "clean": "rm -rf output .spago .cache public/app.js public/bundle.js"
  },
  "devDependencies": {
    "html-webpack-plugin": "^5.5.3",
    "purescript": "^0.15.13",
    "purescript-psa": "^0.8.2",
    "purs-loader": "^0.6.0",
    "spago": "^0.21.0",
    "webpack": "^5.89.0",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.2.2"
  }
}
